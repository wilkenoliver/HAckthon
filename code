<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>µCommunity — Braz Cubas Tech</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #0F1222;
    --bg-2: #171B33;
    --bg-3: #1E2340;
    --amber: #F2A65A;
    --amber-dim: #6B4E2E;
    --violet: #7B6EF6;
    --violet-dim: #35306B;
    --mint: #2FE6C1;
    --text: #EDEFF7;
    --text-dim: #9BA0C0;
    --line: #2B2F52;
    --font-display: 'Space Grotesk', 'Helvetica Neue', Arial, sans-serif;
    --font-body: 'Inter', 'Helvetica Neue', Arial, sans-serif;
    box-sizing: border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  *{ box-sizing: border-box; }
  html{ scroll-padding-top: env(safe-area-inset-top, 0px); scroll-behavior: smooth; }
  html, body{ margin:0; background: var(--bg); color: var(--text); font-family: var(--font-body); }
  body{ min-height: 100%; -webkit-font-smoothing: antialiased; }
  a{ color: inherit; }
  img{ max-width:100%; }

  ::selection{ background: var(--mint); color: #0F1222; }

  .wrap{ max-width: 1080px; margin: 0 auto; padding: 0 24px; }

  /* ---------- NAV ---------- */
  nav{
    position: sticky; top: env(safe-area-inset-top, 0px); z-index: 20;
    background: rgba(15,18,34,0.88); backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  nav .wrap{ display:flex; align-items:center; justify-content:space-between; height: 62px; }
  .brand{ font-family: var(--font-display); font-weight:700; font-size: 1.05rem; letter-spacing: 0.01em; display:flex; align-items:center; gap:8px; }
  .brand .dot{ width:9px; height:9px; border-radius:50%; background: linear-gradient(135deg, var(--amber), var(--violet)); }
  .navlinks{ display:flex; gap: 22px; font-size: 0.92rem; color: var(--text-dim); }
  .navlinks a{ text-decoration:none; }
  .navlinks a:hover{ color: var(--text); }

  /* ---------- HERO ---------- */
  .hero{
    position: relative;
    padding: 76px 0 64px;
    overflow: hidden;
    background:
      radial-gradient(ellipse 60% 50% at 18% 20%, rgba(242,166,90,0.16), transparent 60%),
      radial-gradient(ellipse 60% 50% at 85% 30%, rgba(123,110,246,0.20), transparent 60%);
  }
  .hero-grid{ display:grid; grid-template-columns: 1.15fr 0.85fr; gap: 48px; align-items:center; }
  .kicker{ font-size: 0.85rem; color: var(--mint); font-family: var(--font-display); font-weight:600; margin-bottom: 14px; }
  h1{
    font-family: var(--font-display); font-weight: 700; font-size: clamp(2rem, 4.4vw, 3.1rem);
    line-height: 1.08; margin: 0 0 20px; max-width: 14ch;
  }
  h1 .split{ background: linear-gradient(92deg, var(--amber) 0%, var(--amber) 42%, var(--violet) 58%, var(--violet) 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .hero p.lede{ font-size: 1.06rem; line-height:1.6; color: var(--text-dim); max-width: 48ch; margin: 0 0 28px; }
  .cta-row{ display:flex; gap:12px; flex-wrap: wrap; }
  .btn{
    font-family: var(--font-body); font-weight:600; font-size: 0.92rem; padding: 12px 20px; border-radius: 8px;
    border: 1px solid transparent; cursor:pointer; text-decoration:none; display:inline-flex; align-items:center; gap:8px;
    transition: transform .15s ease, background .15s ease, border-color .15s ease;
  }
  .btn:active{ transform: scale(0.97); }
  .btn-primary{ background: var(--mint); color: #0B2A26; }
  .btn-primary:hover{ background:#54ecce; }
  .btn-ghost{ background: transparent; border-color: var(--line); color: var(--text); }
  .btn-ghost:hover{ border-color: var(--text-dim); }

  .split-card{
    position: relative; border-radius: 16px; overflow:hidden; border:1px solid var(--line);
    aspect-ratio: 1/1; background: var(--bg-2);
  }
  .split-half{ position:absolute; inset:0; display:flex; flex-direction:column; justify-content:flex-end; padding: 18px; }
  .split-half.morning{ clip-path: polygon(0 0, 100% 0, 0 100%); background: linear-gradient(160deg, var(--amber-dim), #221a12); }
  .split-half.night{ clip-path: polygon(100% 0, 100% 100%, 0 100%); background: linear-gradient(340deg, var(--violet-dim), #14152a); }
  .split-half .label{ font-family: var(--font-display); font-weight:600; font-size: 0.95rem; }
  .split-half.morning .label{ color: var(--amber); }
  .split-half.night .label{ color: var(--violet); }
  .split-half .sub{ font-size: 0.78rem; color: var(--text-dim); margin-top:4px; }
  .meet-badge{
    position:absolute; top:50%; left:50%; transform:translate(-50%,-50%);
    width: 74px; height:74px; border-radius:50%; background: var(--mint); color:#0B2A26;
    display:flex; align-items:center; justify-content:center; text-align:center;
    font-family: var(--font-display); font-weight:700; font-size: 0.72rem; line-height:1.15;
    box-shadow: 0 0 0 6px rgba(47,230,193,0.14), 0 8px 24px rgba(0,0,0,0.4);
    padding: 4px;
  }

  @media (max-width: 820px){
    .hero-grid{ grid-template-columns: 1fr; }
    .split-card{ order:-1; max-width: 320px; margin: 0 auto; }
  }

  /* ---------- SECTIONS ---------- */
  section{ padding: 64px 0; border-top: 1px solid var(--line); }
  .section-head{ display:flex; justify-content:space-between; align-items:flex-end; gap: 20px; margin-bottom: 30px; flex-wrap: wrap; }
  .section-head h2{ font-family: var(--font-display); font-weight:700; font-size: clamp(1.5rem, 2.6vw, 1.9rem); margin:0; }
  .section-head p{ color: var(--text-dim); margin: 6px 0 0; max-width: 52ch; font-size: 0.95rem; }

  /* ---------- FILTERS ---------- */
  .filters{ display:flex; gap: 10px; flex-wrap: wrap; margin-bottom: 24px; }
  .chip{
    font-family: var(--font-body); font-size: 0.85rem; font-weight:600; padding: 8px 14px; border-radius: 999px;
    border: 1px solid var(--line); background: var(--bg-2); color: var(--text-dim); cursor:pointer; user-select:none;
    transition: all .15s ease;
  }
  .chip[aria-pressed="true"]{ background: var(--mint); border-color: var(--mint); color: #0B2A26; }
  .chip:hover{ border-color: var(--text-dim); }
  select{
    font-family: var(--font-body); font-size: 0.85rem; padding: 8px 12px; border-radius: 8px;
    background: var(--bg-2); color: var(--text); border: 1px solid var(--line);
  }

  /* ---------- PROJECT GRID ---------- */
  .grid{ display:grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  @media (max-width: 900px){ .grid{ grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px){ .grid{ grid-template-columns: 1fr; } }

  .card{
    background: var(--bg-2); border: 1px solid var(--line); border-radius: 12px; padding: 18px;
    display:flex; flex-direction:column; gap: 10px; transition: border-color .15s ease, transform .15s ease;
  }
  .card:hover{ border-color: var(--text-dim); }
  .card-top{ display:flex; justify-content:space-between; align-items:flex-start; gap: 8px; }
  .card h3{ font-family: var(--font-display); font-size: 1.02rem; margin: 0; }
  .turno-tag{ font-size: 0.68rem; font-weight:700; padding: 3px 9px; border-radius: 999px; white-space:nowrap; }
  .turno-tag.manha{ background: rgba(242,166,90,0.15); color: var(--amber); }
  .turno-tag.noite{ background: rgba(123,110,246,0.18); color: var(--violet); }
  .card .author{ font-size: 0.82rem; color: var(--text-dim); }
  .card p.desc{ font-size: 0.88rem; color: var(--text-dim); line-height:1.5; margin:0; flex-grow:1; }
  .tag-row{ display:flex; gap:6px; flex-wrap:wrap; }
  .tag{ font-size: 0.72rem; padding: 3px 8px; border-radius: 6px; background: var(--bg-3); color: var(--text-dim); border: 1px solid var(--line); }
  .card-cta{
    margin-top: 4px; font-size: 0.82rem; font-weight:600; color: var(--mint); background:none; border:none;
    padding:0; text-align:left; cursor:pointer; display:flex; align-items:center; gap:6px;
  }
  .card-cta:hover{ text-decoration: underline; }
  .empty{ color: var(--text-dim); font-size: 0.9rem; padding: 30px 0; text-align:center; grid-column: 1/-1; }

  /* ---------- MENTORING ---------- */
  .mentor-panel{ display:grid; grid-template-columns: 1fr 1fr; gap: 28px; align-items:start; }
  @media (max-width: 820px){ .mentor-panel{ grid-template-columns: 1fr; } }
  .form-card{ background: var(--bg-2); border: 1px solid var(--line); border-radius: 14px; padding: 24px; }
  .field{ margin-bottom: 16px; }
  .field label{ display:block; font-size: 0.82rem; font-weight:600; margin-bottom: 6px; color: var(--text-dim); }
  .field input, .field select{
    width:100%; padding: 10px 12px; border-radius: 8px; background: var(--bg-3); border: 1px solid var(--line);
    color: var(--text); font-family: var(--font-body); font-size: 0.92rem;
  }
  .field input:focus, .field select:focus, .btn:focus-visible, .chip:focus-visible{
    outline: 2px solid var(--mint); outline-offset: 2px;
  }
  .radio-row{ display:flex; gap: 10px; }
  .radio-row label{
    flex:1; text-align:center; padding: 9px 10px; border-radius: 8px; border:1px solid var(--line);
    background: var(--bg-3); font-size: 0.85rem; cursor:pointer; color: var(--text-dim); font-weight:600;
  }
  .radio-row input{ display:none; }
  .radio-row input:checked + span{ color: inherit; }
  .radio-row label:has(input:checked){ border-color: var(--mint); color: var(--mint); background: rgba(47,230,193,0.08); }

  .results{ min-height: 220px; }
  .result-card{
    background: var(--bg-2); border: 1px solid var(--mint); border-radius: 12px; padding: 16px; margin-bottom: 12px;
    display:flex; gap: 14px; align-items:flex-start;
  }
  .avatar{
    width: 42px; height:42px; border-radius:50%; flex-shrink:0; display:flex; align-items:center; justify-content:center;
    font-family: var(--font-display); font-weight:700; font-size: 0.85rem; color: #0B2A26; background: var(--mint);
  }
  .result-card h4{ margin:0 0 3px; font-family: var(--font-display); font-size: 0.95rem; }
  .result-card .meta{ font-size: 0.78rem; color: var(--text-dim); margin-bottom: 6px; }
  .result-card .why{ font-size: 0.83rem; color: var(--text-dim); line-height:1.4; }
  .placeholder-result{
    border: 1px dashed var(--line); border-radius: 12px; padding: 30px 20px; text-align:center;
    color: var(--text-dim); font-size: 0.88rem;
  }

  /* ---------- HOW IT WORKS mini ---------- */
  .pillars{ display:grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }
  @media (max-width: 820px){ .pillars{ grid-template-columns: repeat(2, 1fr); } }
  .pillar{ background: var(--bg-2); border: 1px solid var(--line); border-radius: 10px; padding: 16px; }
  .pillar .n{ font-family: var(--font-display); color: var(--mint); font-weight:700; font-size: 0.8rem; margin-bottom: 6px; }
  .pillar .t{ font-family: var(--font-display); font-weight:600; font-size: 0.92rem; margin-bottom: 4px; }
  .pillar .d{ font-size: 0.78rem; color: var(--text-dim); line-height:1.4; }

  footer{ padding: 40px 0 60px; border-top: 1px solid var(--line); }
  footer p{ color: var(--text-dim); font-size: 0.85rem; max-width: 60ch; line-height:1.6; }
  footer .fbrand{ font-family: var(--font-display); font-weight:700; margin-bottom: 10px; }

  @media (prefers-reduced-motion: reduce){ *{ transition: none !important; scroll-behavior: auto !important; } }
</style>
</head>
<body>

<nav>
  <div class="wrap">
    <div class="brand"><span class="dot"></span>µCommunity</div>
    <div class="navlinks">
      <a href="#vitrine">Vitrine</a>
      <a href="#mentoria">Mentoria</a>
      <a href="#comunidade">A ideia</a>
    </div>
  </div>
</nav>

<header class="hero">
  <div class="wrap hero-grid">
    <div>
      <div class="kicker">µHACKATHON · CENTRO UNIVERSITÁRIO BRAZ CUBAS</div>
      <h1>Manhã e noite, <span class="split">uma comunidade só</span></h1>
      <p class="lede">Os projetos e contatos dos alunos de tecnologia ficam presos em cada turma e somem depois da formatura. O µCommunity junta uma vitrine de projetos reais com uma rede de mentoria entre estudantes e egressos — pra quem chega ver o que já existe e sair com um mentor sugerido.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="#vitrine">Ver projetos da comunidade</a>
        <a class="btn btn-ghost" href="#mentoria">Encontrar um parceiro de mentoria</a>
      </div>
    </div>
    <div class="split-card" aria-hidden="true">
      <div class="split-half morning"><div class="label">Turma da manhã</div><div class="sub">projetos, dúvidas, portfólio</div></div>
      <div class="split-half night"><div class="label">Turma da noite</div><div class="sub">projetos, dúvidas, portfólio</div></div>
      <div class="meet-badge">SE ENCONTRAM AQUI</div>
    </div>
  </div>
</header>

<section id="comunidade">
  <div class="wrap">
    <div class="section-head">
      <div>
        <h2>Uma plataforma não é uma comunidade</h2>
        <p>Ela só facilita o encontro. O que faz alguém entrar, participar e voltar são estes cinco elementos — é neles que o protótipo abaixo foi desenhado.</p>
      </div>
    </div>
    <div class="pillars">
      <div class="pillar"><div class="n">01</div><div class="t">Pessoas</div><div class="d">Alunos de duas turmas e egressos, num só lugar.</div></div>
      <div class="pillar"><div class="n">02</div><div class="t">Interesse comum</div><div class="d">Tecnologia, projetos e carreira em tech.</div></div>
      <div class="pillar"><div class="n">03</div><div class="t">Interação</div><div class="d">Pedir mentoria sobre um projeto que viu na vitrine.</div></div>
      <div class="pillar"><div class="n">04</div><div class="t">Valor</div><div class="d">Portfólio visível, feedback real, indicação.</div></div>
      <div class="pillar"><div class="n">05</div><div class="t">Continuidade</div><div class="d">Mentorias recorrentes, não um encontro único.</div></div>
    </div>
  </div>
</section>

<section id="vitrine">
  <div class="wrap">
    <div class="section-head">
      <div>
        <h2>Vitrine de projetos</h2>
        <p>Projetos feitos por alunos da Braz Cubas. Filtre por turma pra descobrir o que a outra turma anda construindo.</p>
      </div>
    </div>
    <div class="filters">
      <button class="chip" data-turno="todos" aria-pressed="true">Todos</button>
      <button class="chip" data-turno="manha" aria-pressed="false">Turma da manhã</button>
      <button class="chip" data-turno="noite" aria-pressed="false">Turma da noite</button>
      <select id="tagFilter" aria-label="Filtrar por tecnologia">
        <option value="todos">Todas as tecnologias</option>
      </select>
    </div>
    <div class="grid" id="projectGrid"></div>
  </div>
</section>

<section id="mentoria">
  <div class="wrap">
    <div class="section-head">
      <div>
        <h2>Rede de mentoria</h2>
        <p>Diga seu interesse e sua turma. Priorizamos gente da turma oposta e egressos, pra cruzar quem normalmente nunca se encontraria.</p>
      </div>
    </div>
    <div class="mentor-panel">
      <div class="form-card">
        <div class="field">
          <label for="mName">Seu nome</label>
          <input id="mName" type="text" placeholder="Como quer ser chamado(a)">
        </div>
        <div class="field">
          <label>Sua turma</label>
          <div class="radio-row">
            <label><input type="radio" name="turno" value="manha" checked><span>Manhã</span></label>
            <label><input type="radio" name="turno" value="noite"><span>Noite</span></label>
          </div>
        </div>
        <div class="field">
          <label for="mInterest">Área de interesse</label>
          <select id="mInterest"></select>
        </div>
        <button class="btn btn-primary" id="matchBtn" style="width:100%; justify-content:center;">Encontrar parceiro de mentoria</button>
      </div>
      <div class="results" id="resultsArea">
        <div class="placeholder-result">Preencha o formulário e clique em "Encontrar parceiro" pra ver sugestões de mentores compatíveis.</div>
      </div>
    </div>
  </div>
</section>

<footer>
  <div class="wrap">
    <div class="fbrand">µCommunity</div>
    <p>Protótipo experimental feito para o µHackathon do Centro Universitário Braz Cubas. Dados de projetos e mentores são exemplos ilustrativos, usados para demonstrar o fluxo de navegação e o match de mentoria — a próxima etapa é conectar isso a cadastros reais dos alunos.</p>
  </div>
</footer>

<script>
const TAGS = ["Web","Mobile","IA","Dados","Design","Jogos","IoT","Segurança"];

const PROJECTS = [
  { name:"TrilhaCerta", author:"Ana Ferreira", turno:"manha", tags:["Mobile","IA"], desc:"App de orientação de carreira que sugere trilhas de estudo pra calouros indecisos." },
  { name:"BikeShare Campus", author:"Bruno Ramos", turno:"noite", tags:["IoT","Web"], desc:"Sistema de bicicletas compartilhadas com trava inteligente e reserva pelo celular." },
  { name:"EstudaJunto", author:"Carla Mendes", turno:"manha", tags:["Web","Design"], desc:"Plataforma pra montar grupos de estudo por matéria e horário disponível." },
  { name:"SegurAlerta", author:"Diego Costa", turno:"noite", tags:["Mobile","Segurança"], desc:"Botão de pânico e alerta geolocalizado pra quem sai tarde do campus." },
  { name:"DadosBC", author:"Elisa Prado", turno:"manha", tags:["Dados","Web"], desc:"Dashboard com indicadores acadêmicos abertos pra coordenação e alunos." },
  { name:"PixelQuest", author:"Felipe Rocha", turno:"noite", tags:["Jogos","Design"], desc:"Jogo educativo em pixel art sobre a história da instituição." },
  { name:"TutorIA", author:"Giovana Alves", turno:"manha", tags:["IA","Web"], desc:"Chatbot que responde dúvidas comuns de programação das disciplinas iniciais." },
  { name:"AcessoFácil", author:"Heitor Lima", turno:"noite", tags:["Design","Mobile"], desc:"Protótipo de acessibilidade pro app do aluno, pensado pra baixa visão." },
];

const MENTORS = [
  { name:"Mariana Cruz", role:"Egressa · Cientista de Dados", tags:["IA","Dados"], turno:"noite" },
  { name:"Rafael Souza", role:"Egresso · Dev Front-end", tags:["Web","Design"], turno:"manha" },
  { name:"Juliana Alves", role:"Egressa · Dev Mobile", tags:["Mobile","Segurança"], turno:"qualquer" },
  { name:"Pedro Lima", role:"Egresso · Eng. de IoT", tags:["IoT","Dados"], turno:"noite" },
  { name:"Camila Torres", role:"Aluna veterana · Game Dev", tags:["Jogos","Design"], turno:"manha" },
  { name:"Thiago Nunes", role:"Egresso · Full-stack & IA", tags:["Web","IA"], turno:"qualquer" },
];

let activeTurno = "todos";
let activeTag = "todos";

function initials(name){
  return name.split(" ").map(p=>p[0]).slice(0,2).join("").toUpperCase();
}

function renderTagOptions(){
  const filterSel = document.getElementById("tagFilter");
  const interestSel = document.getElementById("mInterest");
  TAGS.forEach(t=>{
    const o1 = document.createElement("option"); o1.value = t; o1.textContent = t;
    filterSel.appendChild(o1);
    const o2 = document.createElement("option"); o2.value = t; o2.textContent = t;
    interestSel.appendChild(o2);
  });
}

function renderGrid(){
  const grid = document.getElementById("projectGrid");
  grid.innerHTML = "";
  const filtered = PROJECTS.filter(p=>{
    const okTurno = activeTurno === "todos" || p.turno === activeTurno;
    const okTag = activeTag === "todos" || p.tags.includes(activeTag);
    return okTurno && okTag;
  });
  if(filtered.length === 0){
    grid.innerHTML = '<div class="empty">Nenhum projeto com esse filtro ainda. Tente outra combinação.</div>';
    return;
  }
  filtered.forEach(p=>{
    const card = document.createElement("div");
    card.className = "card";
    card.innerHTML = `
      <div class="card-top">
        <h3>${p.name}</h3>
        <span class="turno-tag ${p.turno}">${p.turno === "manha" ? "Manhã" : "Noite"}</span>
      </div>
      <div class="author">por ${p.author}</div>
      <p class="desc">${p.desc}</p>
      <div class="tag-row">${p.tags.map(t=>`<span class="tag">${t}</span>`).join("")}</div>
      <button class="card-cta" data-interest="${p.tags[0]}">Pedir mentoria sobre isso →</button>
    `;
    grid.appendChild(card);
  });
  grid.querySelectorAll(".card-cta").forEach(btn=>{
    btn.addEventListener("click", ()=>{
      document.getElementById("mInterest").value = btn.dataset.interest;
      document.getElementById("mentoria").scrollIntoView({behavior:"smooth"});
    });
  });
}

document.querySelectorAll(".chip").forEach(chip=>{
  chip.addEventListener("click", ()=>{
    document.querySelectorAll(".chip").forEach(c=>c.setAttribute("aria-pressed","false"));
    chip.setAttribute("aria-pressed","true");
    activeTurno = chip.dataset.turno;
    renderGrid();
  });
});

document.getElementById("tagFilter").addEventListener("change", (e)=>{
  activeTag = e.target.value;
  renderGrid();
});

document.getElementById("matchBtn").addEventListener("click", ()=>{
  const interest = document.getElementById("mInterest").value;
  const userTurno = document.querySelector('input[name="turno"]:checked').value;
  const resultsArea = document.getElementById("resultsArea");

  if(!interest){
    resultsArea.innerHTML = '<div class="placeholder-result">Escolha uma área de interesse pra buscarmos um match.</div>';
    return;
  }

  let matches = MENTORS.filter(m=>m.tags.includes(interest));
  matches.sort((a,b)=>{
    const score = (m)=> (m.turno === "qualquer" ? 2 : (m.turno !== userTurno ? 3 : 1));
    return score(b) - score(a);
  });
  matches = matches.slice(0,2);

  if(matches.length === 0){
    resultsArea.innerHTML = '<div class="placeholder-result">Ainda não temos mentor cadastrado nessa área — esse pedido entraria na fila de matches pendentes, pra sinalizar demanda pra próxima leva de egressos.</div>';
    return;
  }

  resultsArea.innerHTML = matches.map(m=>{
    const bridge = m.turno === "qualquer" ? "disponível pras duas turmas" : (m.turno !== userTurno ? `da turma da ${m.turno === "manha" ? "manhã" : "noite"}, cruzando com a sua` : "da mesma turma que você");
    return `
      <div class="result-card">
        <div class="avatar">${initials(m.name)}</div>
        <div>
          <h4>${m.name}</h4>
          <div class="meta">${m.role} · ${bridge}</div>
          <div class="why">Sugerido por interesse em <strong>${interest}</strong>. Próximo passo: enviar um convite de conversa de 20 minutos.</div>
        </div>
      </div>
    `;
  }).join("");
});

renderTagOptions();
renderGrid();
</script>

</body>
</html>
